[
  { "term": "CAM", "en": "Computer-Aided Manufacturing", "def": "计算机辅助制造：用软件把零件几何转化为可执行的加工指令（刀路+G代码），覆盖工艺规划、刀路计算、后处理与仿真。", "rel": [ {"title":"CAM 是什么","section":"cam","slug":"what-is-cam"}, {"title":"CAD→CAM→CNC 链路","section":"cam","slug":"cad-cam-cnc"} ] },
  { "term": "CAD", "en": "Computer-Aided Design", "def": "计算机辅助设计：生成零件的几何模型（2D/3D），是 CAM 的输入。", "rel": [ {"title":"CAD→CAM→CNC 链路","section":"cam","slug":"cad-cam-cnc"} ] },
  { "term": "CNC", "en": "Computer Numerical Control", "def": "计算机数控：机床的数控系统，解析 G 代码并驱动机床各轴执行切削。", "rel": [ {"title":"后处理器与 G 代码","section":"cam","slug":"postprocessor"} ] },
  { "term": "NC", "en": "Numerical Control", "def": "数值控制：用数字指令驱动机床运动，是 CNC 的前身（早期用打孔纸带）。", "rel": [ {"title":"发展时间线","section":"history","slug":"timeline"} ] },
  { "term": "G 代码", "en": "G-code", "def": "以地址字（G/M/X/Y/Z 等）描述机床动作的文本指令，源自 EIA RS-274、ISO 6983。", "rel": [ {"title":"后处理器与 G 代码","section":"cam","slug":"postprocessor"} ] },
  { "term": "APT", "en": "Automatically Programmed Tools", "def": "MIT 于 1950 年代发展的数控编程语言，用几何+刀具运动的高级描述生成刀路，是 CAM 的思想源头。", "rel": [ {"title":"发展时间线","section":"history","slug":"timeline"}, {"title":"后处理器与 G 代码","section":"cam","slug":"postprocessor"} ] },
  { "term": "CLDATA", "en": "Cutter Location Data", "def": "刀位数据：与机床无关的刀具中心轨迹中间表示，由后处理器翻译为目标 G 代码。", "rel": [ {"title":"后处理器与 G 代码","section":"cam","slug":"postprocessor"} ] },
  { "term": "后处理", "en": "Post-Processor", "def": "把通用刀路（CLDATA）翻译为特定机床/系统可执行的 G 代码的模块。", "rel": [ {"title":"后处理器与 G 代码","section":"cam","slug":"postprocessor"} ] },
  { "term": "刀具路径", "en": "Toolpath", "def": "刀具中心依次经过的空间点序列，由 CAM 按策略（等高/平行/自适应等）计算。", "rel": [ {"title":"刀具路径生成原理","section":"cam","slug":"toolpath"} ] },
  { "term": "五轴加工", "en": "5-Axis Machining", "def": "三直线轴+两旋转轴的加工，刀轴可任意取向，适合复杂曲面与深腔。", "rel": [ {"title":"五轴加工（工艺库）","section":"processes","slug":"5-axis"}, {"title":"刀具路径生成原理","section":"cam","slug":"toolpath"} ] },
  { "term": "3+2 加工", "en": "5-Axis Positioning / 3+2", "def": "先摆动固定刀轴角度，再做三轴加工，刚性好、适合深腔。", "rel": [ {"title":"五轴加工（工艺库）","section":"processes","slug":"5-axis"} ] },
  { "term": "铣削", "en": "Milling", "def": "旋转刀具 + 工件进给的切削工艺，擅长平面、型腔与曲面。", "rel": [ {"title":"铣削 Milling","section":"processes","slug":"milling"} ] },
  { "term": "车削", "en": "Turning", "def": "工件旋转、刀具进给的工艺，适合回转体（轴/盘/套）。", "rel": [ {"title":"车削 Turning","section":"processes","slug":"turning"} ] },
  { "term": "EDM", "en": "Electrical Discharge Machining", "def": "电火花加工：用脉冲放电蚀除导电材料，无切削力，适合硬材与复杂轮廓。", "rel": [ {"title":"电火花加工 EDM","section":"processes","slug":"edm"} ] },
  { "term": "公差", "en": "Tolerance", "def": "允许的尺寸偏差范围；ISO 286 用 IT01–IT18 分级，数字越小越精。", "rel": [ {"title":"公差与表面粗糙度","section":"processes","slug":"tolerance"} ] },
  { "term": "IT 等级", "en": "ISO Tolerance Grade", "def": "标准公差等级（IT01–IT18），同一基本尺寸下等级越小公差越小。", "rel": [ {"title":"公差与表面粗糙度","section":"processes","slug":"tolerance"} ] },
  { "term": "表面粗糙度 Ra", "en": "Roughness (Ra)", "def": "轮廓算术平均偏差，单位 μm；数值越小表面越光滑。", "rel": [ {"title":"公差与表面粗糙度","section":"processes","slug":"tolerance"} ] },
  { "term": "HSM", "en": "High Speed Machining", "def": "高速铣削：高转速、小切深、大进给的轻快切削，适合淬硬钢与薄壁件。", "rel": [ {"title":"铣削 Milling","section":"processes","slug":"milling"} ] },
  { "term": "HSK", "en": "Hollow Shank Taper", "def": "空心短锥刀柄，端面+锥面双面定位，高速刚性优于 BT。", "rel": [ {"title":"刀具与刀柄系统","section":"processes","slug":"tools"} ] },
  { "term": "BT 锥柄", "en": "BT Taper (7:24)", "def": "7:24 实心锥柄，传统主流刀柄，靠锥面定位。", "rel": [ {"title":"刀具与刀柄系统","section":"processes","slug":"tools"} ] },
  { "term": "CMM", "en": "Coordinate Measuring Machine", "def": "三坐标测量机：用测头逐点采样，比对 CAD 模型得到尺寸与形位偏差。", "rel": [ {"title":"计量与检测","section":"processes","slug":"metrology"} ] },
  { "term": "数字孪生", "en": "Digital Twin", "def": "把机床物理特性建进虚拟模型，使仿真更贴近真实加工，是智能制造一环。", "rel": [ {"title":"仿真与碰撞检测","section":"cam","slug":"simulation"}, {"title":"趋势专题","section":"market","slug":"trends"} ] },
  { "term": "DFM", "en": "Design for Manufacturability", "def": "可制造性设计：在设计阶段就考虑加工工艺性，降低制造难度与成本。", "rel": [ {"title":"工艺选型指南","section":"processes","slug":"guide"} ] },
  { "term": "加工中心", "en": "Machining Center", "def": "带自动换刀与刀库、可多工序加工的 CNC 机床，体现制造柔性。", "rel": [ {"title":"发展时间线","section":"history","slug":"timeline"} ] },
  { "term": "仿真校验", "en": "Verification / Simulation", "def": "上机前在软件内虚拟切削，检查过切、撞刀与超程。", "rel": [ {"title":"仿真与碰撞检测","section":"cam","slug":"simulation"} ] }
]
